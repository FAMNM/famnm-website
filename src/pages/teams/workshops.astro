---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Picture } from "astro:assets";
import workshopPicture from "../../images/teams/ftc-workshop-2025.jpg";
---

<BaseLayout
  title="Workshops | FIRST® Alumni & Mentors Network at Michigan"
>
  <div class="container">
    <main class="content">
      <h1>Workshops</h1>
      <p class="text-par">
        FAMNM hosts robotics workshops for <i>FIRST</i> teams throughout the
        year at the University of Michigan. Workshops are open to all teams.
      </p>
      <h2 class="h4">FTC Engineering Notebook &amp; Presentation Seminar</h2>
      <p class="text-par">
        FTC teams practice judge interviews with FAMNM members and get feedback
        on their engineering portfolios. Fall 2026 sessions:
      </p>
      <ul>
        <li>Tuesday, October 27, 7:00&ndash;8:30 PM</li>
        <li>Tuesday, November 17, 6:30&ndash;8:00 PM</li>
      </ul>
      <p class="text-par">
        To bring your team or ask about future workshops, email
        <a href="mailto:famnm.projects@umich.edu">famnm.projects@umich.edu</a>.
      </p>
      <Picture
        class="img-fluid col-md-8 col-xs-12 d-inline-block"
        id="workshop-img"
        src={workshopPicture}
        alt="FAMNM members reviewing an engineering notebook with an FTC team"
      />
    </main>
  </div>
</BaseLayout>
