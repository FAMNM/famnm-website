---
import type { CoreMember } from "../../components/about/CoreMemberCard.astro";
import CoreMemberCard from "../../components/about/CoreMemberCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const people: CoreMember[] = [
  {
    name: "Brandon McDonald",
    email: "famnm.pres",
    img: "about/core/temp.jpg",
    role: "President & Volunteer Coordinator",
  },
  {
    name: "Meghana Sennerikuppam",
    email: "famnm.vp",
    img: "about/core/temp.jpg",
    role: "Vice President",
  },
  {
    name: "Peter Celani",
    email: "famnm.admin",
    img: "about/core/temp.jpg",
    role: "Director of Internal Affairs & Kickoff Coordinator",
  },
  {
    name: "Jack Wilds",
    email: "famnm.treasurer",
    img: "about/core/temp.jpg",
    role: "Treasurer & Ri3D Coordinator",
  },
  {
    name: "Danny Abraham",
    email: "famnm.marketing",
    img: "about/core/temp.jpg",
    role: "Director of Marketing and Campus Outreach",
  },
  {
    name: "Chelsea Weber",
    email: "famnm.projects",
    img: "about/core/temp.jpg",
    role: "Director of Project Development",
  },
  {
    name: "Carter Koch",
    email: "famnm.webmaster",
    img: "about/core/temp.jpg",
    role: "Webmaster",
  },
];
---

<BaseLayout
  title="FAMNM Core Team | FIRST® Alumni & Mentors Network at Michigan"
>
  <div class="container">
    <div class="content">
      <h1>FAMNM Core Team 2026&ndash;2027</h1>
      <p class="text-center">
        All FAMNM Core Team members can be reached at <a
          href="mailto:famnm.core@umich.edu">famnm.core@umich.edu</a
        >.
      </p>
      <div class="row g-4 row-cols-auto d-flex justify-content-center">
        {
          people.map((info) => (
            <div class="col">
              <CoreMemberCard info={info} />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
